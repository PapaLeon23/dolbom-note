rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function rolePath(uid) { return /databases/$(database)/documents/roles/$(uid); }
    function sitterPath(uid) { return /databases/$(database)/documents/sitters/$(uid); }
    function role() {
      return signedIn() && exists(rolePath(request.auth.uid))
        ? get(rolePath(request.auth.uid)).data.role : 'none';
    }
    function admin() { return role() == 'admin'; }
    function member() { return role() in ['admin', 'sitter']; }
    function assigned() {
      return signedIn() && role() == 'sitter'
        && exists(sitterPath(request.auth.uid))
        && get(sitterPath(request.auth.uid)).data.active == true
        && get(sitterPath(request.auth.uid)).data.assignedChildren.size() > 0;
    }
    function childAssigned(childId) {
      return assigned()
        && childId in get(sitterPath(request.auth.uid)).data.assignedChildren;
    }

    // Firebase 콘솔에서만 계정 역할 생성/수정. 웹페이지에서는 절대 못 바꿉니다.
    match /roles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      // 관리자만 'sitter' 역할 계정 목록을 조회할 수 있습니다.
      allow list: if admin();
      allow create, update, delete: if false;
    }

    match /settings/{key} {
      allow get: if key == 'main' && member();
      allow list: if false;
      allow create, update: if key == 'main' && admin()
        && request.resource.data.keys().hasAll(['child1', 'child2', 'payrollStartDay', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['child1', 'child2', 'payrollStartDay', 'updatedAt'])
        && request.resource.data.child1 is string && request.resource.data.child1.size() <= 30
        && request.resource.data.child2 is string && request.resource.data.child2.size() <= 30
        && request.resource.data.payrollStartDay is int
        && request.resource.data.payrollStartDay >= 1 && request.resource.data.payrollStartDay <= 31
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /sitters/{uid} {
      allow get: if admin() || (signedIn() && request.auth.uid == uid && role() == 'sitter');
      allow list: if admin();
      allow create, update: if admin()
        && uid.size() <= 128
        && exists(rolePath(uid)) && get(rolePath(uid)).data.role == 'sitter'
        && request.resource.data.keys().hasAll(['name','hourlyRate','rateHistory','assignedChildren','active','updatedAt'])
        && request.resource.data.keys().hasOnly(['name','hourlyRate','rateHistory','assignedChildren','active','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 50
        && request.resource.data.hourlyRate is int
        && request.resource.data.hourlyRate >= 1000 && request.resource.data.hourlyRate <= 1000000
        && request.resource.data.rateHistory is list && request.resource.data.rateHistory.size() > 0
        && request.resource.data.rateHistory.size() <= 100
        && request.resource.data.assignedChildren is list && request.resource.data.assignedChildren.size() <= 2
        && request.resource.data.assignedChildren.hasOnly(['child1','child2'])
        && request.resource.data.active is bool && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /schedules/{scheduleId} {
      // 목록 조회도 반드시 sitterUid == 로그인 UID인 쿼리여야 합니다.
      allow get, list: if admin() || (assigned() && resource.data.sitterUid == request.auth.uid);
      allow create, update: if admin()
        && request.resource.data.keys().hasAll(['date','sitterUid','start','extraMinutes','status','memo','updatedAt'])
        && request.resource.data.keys().hasOnly(['date','sitterUid','start','extraMinutes','status','memo','updatedAt','careType'])
        && (!request.resource.data.keys().hasAny(['careType'])
          || (request.resource.data.careType in ['pickup','extended','off']
            && (request.resource.data.careType != 'pickup' || request.resource.data.extraMinutes == 0)
            && (request.resource.data.careType != 'extended' || request.resource.data.extraMinutes >= 30)
            && (request.resource.data.careType != 'off' || (request.resource.data.extraMinutes == 0 && request.resource.data.status == 'scheduled'))))
        && request.resource.data.sitterUid is string
        && exists(sitterPath(request.resource.data.sitterUid))
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && scheduleId == request.resource.data.sitterUid + '__' + request.resource.data.date
        && request.resource.data.start == '16:30'
        && request.resource.data.extraMinutes is int
        && request.resource.data.extraMinutes >= 0 && request.resource.data.extraMinutes <= 360
        && request.resource.data.extraMinutes % 30 == 0
        && request.resource.data.status in ['scheduled','completed','paid']
        && request.resource.data.memo is string && request.resource.data.memo.size() <= 500
        && request.resource.data.updatedAt is timestamp;
      allow delete: if admin();
    }

    // 아이/날짜별로 투약 요청을 분리하여, 배정된 시터만 본인 담당 아이 요청 조회 가능.
    // 기본 목록 조회 금지: 웹앱은 필요한 날짜의 문서만 직접 읽습니다.
    match /medications/{childId}/days/{day} {
      allow get: if childId in ['child1','child2'] && (admin() || childAssigned(childId));
      allow list: if false;
      allow create, update: if admin() && childId in ['child1','child2']
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasAll(['items','updatedAt'])
        && request.resource.data.keys().hasOnly(['items','updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 10
        && request.resource.data.updatedAt is timestamp;
      allow delete: if admin();
    }

    // 아이별 문서가 물리적으로 분리되어 시터는 배정된 아이의 메모만 조회 가능합니다.
    match /notices/{childId} {
      allow get: if childId in ['child1','child2'] && (admin() || childAssigned(childId));
      allow list: if false;
      allow create, update: if admin() && childId in ['child1','child2']
        && request.resource.data.keys().hasAll(['forDate','message','supplies','updatedAt'])
        && request.resource.data.keys().hasOnly(['forDate','message','supplies','updatedAt'])
        && request.resource.data.forDate is string
        && request.resource.data.forDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.message is string && request.resource.data.message.size() <= 600
        && request.resource.data.supplies is string && request.resource.data.supplies.size() <= 300
        && request.resource.data.updatedAt is timestamp;
      allow delete: if admin();
    }
  }
}
